{
  "name": "careerpilot-android-mockups",
  "private": true,
  "version": "1.0.0",
  "description": "Rendered Android screen mockups for CareerPilot — generated from real HTML/CSS against the web app's design tokens.",
  "type": "module",
  "scripts": {
    "render": "python3 build.py",
    "contact-sheet": "magick montage png/{01,02,03,04,05,06,07,08,09,10}-*.png -tile 5x2 -geometry 592x1010+14+14 -background '#0d1005' png/00-contact-sheet.png",
    "postinstall": "playwright install firefox"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
