# Design-only repository.
#
# The app toolchain entries that used to live here (node_modules, .expo,
# android/app/build, *.apk, eas.json, jest cache) went with the implementation.
# What remains is the mockup render pipeline.

# dependencies, if you install playwright to re-render the mockups
node_modules/

# python (mockup render pipeline)
__pycache__/
*.py[cod]

# rendered intermediates — build.py writes NN-*.html next to screens.py
design/[0-9][0-9]-*.html

# env & secrets — never commit
.env
.env.*
!.env.example

# logs
*.log

# editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
