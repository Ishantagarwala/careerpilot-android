# Copy to .env (gitignored) and fill in. Only EXPO_PUBLIC_* vars are readable
# from app code, and they are INLINED AT BUILD TIME — changing one requires a
# rebuild, not just a reload.

# ---- Bot verification -------------------------------------------------------
#
# The server runs every sign-in through a bot gate and refuses when it cannot
# verify the client (design/API_CONTRACT.md §1.2). Two ways through it:

# 1. Play Integrity (strongest). Needs the Cloud project NUMBER — 11-12 digits
#    from Cloud console -> IAM & Admin -> Settings, NOT the project id and NOT
#    the service account's Unique ID. Not a secret; it ships in the APK.
#
#    Requires a Play Console account and a build INSTALLED FROM GOOGLE PLAY.
#    A sideloaded APK fails attestation, so leave the disable flag set until the
#    app ships through Play.
EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER=

#    Set to 1 to skip attestation and use the captcha below instead.
EXPO_PUBLIC_PLAY_INTEGRITY_DISABLED=

# 2. hCaptcha in a webview — the fallback when the app cannot attest, and the
#    same gate the web sign-in passes. Site key only; the secret stays server
#    side (HCAPTCHA_SECRET_KEY).
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=
