{
  "expo": {
    "name": "CareerPilot",
    "slug": "careerpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "careerpilot",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f6e8"
    },
    "android": {
      "package": "cc.careerpilot.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#baf600"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "CareerPilot uses Face unlock to sign you in."
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://careerpilot.cc",
      "router": {},
      "eas": {
        "projectId": "b71ee2e5-eb63-4280-b3be-b9e428473898"
      }
    }
  }
}
